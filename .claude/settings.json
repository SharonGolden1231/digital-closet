{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch --show-current)",
      "Bash(git fetch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(npm ci)",
      "Bash(npm run build)",
      "Bash(npx tsc --noEmit *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(git branch)",
      "PowerShell(git branch --show-current)",
      "PowerShell(git fetch *)",
      "PowerShell(git add *)",
      "PowerShell(git commit *)",
      "PowerShell(npm ci)",
      "PowerShell(npm run build)",
      "PowerShell(npx tsc --noEmit *)"
    ],
    "ask": [
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git revert *)",
      "Bash(git stash *)",
      "Bash(npm install *)",
      "Bash(npm run dev *)",
      "PowerShell(git switch *)",
      "PowerShell(git checkout *)",
      "PowerShell(git revert *)",
      "PowerShell(git stash *)",
      "PowerShell(npm install *)",
      "PowerShell(npm run dev *)"
    ],
    "deny": [
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git -C *)",
      "Bash(git -c *)",
      "Bash(supabase *)",
      "Bash(npx supabase *)",
      "Bash(npm exec *)",
      "Bash(vercel *)",
      "Bash(npx vercel *)",
      "Bash(gh *)",
      "Bash(curl *)",
      "Bash(rm *)",
      "PowerShell(git push *)",
      "PowerShell(git merge *)",
      "PowerShell(git rebase *)",
      "PowerShell(git reset *)",
      "PowerShell(git clean *)",
      "PowerShell(git branch -d *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git -C *)",
      "PowerShell(git -c *)",
      "PowerShell(supabase *)",
      "PowerShell(npx supabase *)",
      "PowerShell(npm exec *)",
      "PowerShell(vercel *)",
      "PowerShell(npx vercel *)",
      "PowerShell(gh *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(Remove-Item *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(./supabase/**)",
      "Edit(./api/**)",
      "Edit(./package.json)",
      "Edit(./package-lock.json)",
      "Edit(./vercel.json)",
      "Edit(./.claude/**)"
    ]
  }
}
